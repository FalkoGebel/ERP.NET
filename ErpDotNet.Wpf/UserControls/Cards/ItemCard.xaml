<UserControl x:Class="ErpDotNet.Wpf.UserControls.Cards.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ErpDotNet.Wpf.UserControls.Cards"
             xmlns:texts="clr-namespace:ErpDotNet.Wpf.Texts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:ItemCard, IsDesignTimeCreatable=True}"
             x:Name="root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="{x:Static texts:ItemCard.OkButtonContent}" Margin="5" Padding="5">
                <Button.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Ok, ElementName=root}" />
                </Button.InputBindings>
            </Button>
            <Button Content="{x:Static texts:ItemCard.CancelButtonContent}" Margin="5" Padding="5">
                <Button.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding Cancel, ElementName=root}" />
                </Button.InputBindings>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Label Content="{x:Static texts:ItemCard.ItemNumberLabelContent}" Margin="5" Padding="5" Width="200"/>
                <TextBox Text="{Binding Item.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ElementName=root}" Margin="5" Padding="5" Width="200" IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="{x:Static texts:ItemCard.ItemDescriptionLabelContent}" Margin="5" Padding="5" Width="200"/>
                <TextBox Text="{Binding Item.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ElementName=root}" Margin="5" Padding="5" Width="200"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
